{
  "manifest_version": 3,
  "name": "随手表情 · AI 聊天收藏夹",
  "version": "0.5.0",
  "icons": {"16":"icons/icon16.png","32":"icons/icon32.png","48":"icons/icon48.png","128":"icons/icon128.png"},
  "background": {"service_worker": "background.js"},
  "description": "点选收藏的表情图片，直接发送到 ChatGPT 或 Muse，不附加解释文字。",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://muse.ai/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
